# ============================================
# 環境変数テンプレート
# 実際の値はコピーせず、Renderのダッシュボード
# (Environment タブ)に直接設定すること。
# ローカルで試す場合のみ、このファイルを .env にコピーして値を埋める。
# ============================================

# --- サーバー基本設定 ---
PORT=3000
RENDER_EXTERNAL_URL=https://your-app.onrender.com

# --- Gemini API ---
GEMINI_API_KEY=

# --- WordPress ---
WP_APP_USER=
WP_APP_PASSWORD=
WP_BASE_URL=https://hair-pocket.com

# --- Google Business Profile (GBP) ---
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
GBP_REFRESH_TOKEN=

# --- Google Sheets (footer_master / publish_log) ---
# サービスアカウントのJSONキーを1行の文字列にして設定する
# (改行は \n のままでOK。コード側でパースする)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
FOOTER_SHEET_ID=

# --- LINE / LIFF ---
LIFF_ID=
LINE_CHANNEL_TOKEN=
LINE_USER_ID=

# --- SalonBoard(店舗ごとに追加していく。まずは1店舗分) ---
SALONBOARD_MERRY_ID=
SALONBOARD_MERRY_PASSWORD=
